{
  "name": "@cbepx/codex-plugin-cc",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "node -e \"require('fs').mkdirSync('plugins/codex/.generated/app-server-types',{recursive:true})\" && codex app-server generate-ts --out plugins/codex/.generated/app-server-types",
    "build": "tsc -p tsconfig.app-server.json",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "npm run build",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check": "npm run check-version && npm run check:changelog && npm run lint && npm run build && npm run typecheck:tests && npm test",
    "prepack": "npm run check-version && npm run check:changelog",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "test:coverage": "c8 node scripts/run-tests.mjs",
    "test:mutation:critical": "stryker run stryker.config.mjs",
    "test:mutation:critical:force": "stryker run stryker.config.mjs --force",
    "test:mutation:critical:unit": "node --import ./tests/test-env.mjs --test tests/args.test.mjs tests/model-catalog.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^25.5.0",
    "c8": "12.0.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript": "^6.0.2"
  }
}
